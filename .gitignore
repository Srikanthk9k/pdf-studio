# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
server/dist/

# ── Environment files (contain localhost / secrets — never commit these) ──────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# .env.example is safe to commit (it's just a template with no real values)

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Temp uploads (server runtime) ─────────────────────────────────────────────
/tmp/pdf-studio-uploads/

# ── TypeScript build info ──────────────────────────────────────────────────────
*.tsbuildinfo
